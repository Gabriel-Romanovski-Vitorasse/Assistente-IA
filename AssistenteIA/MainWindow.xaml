<Window x:Class="AssistenteIA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:AssistenteIA.Models"
        Title="Assistente IA · WPF + .NET 10"
        Height="720" Width="1120" MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>

        <!-- Aparência de cada mensagem (balão) do chat -->
        <DataTemplate x:Key="ModeloMensagem" DataType="{x:Type m:MensagemChat}">
            <Border x:Name="Balao"
                    Margin="0,6" Padding="14,10" CornerRadius="12" MaxWidth="680"
                    HorizontalAlignment="Left"
                    Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="Autor" Text="{Binding Autor}"
                               FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>

                    <TextBlock x:Name="Pensando" Text="⏳ pensando..." Foreground="#9CA3AF"
                               FontStyle="Italic" Visibility="Collapsed"/>

                    <!-- TextBox somente leitura: permite selecionar e copiar a resposta -->
                    <TextBox x:Name="Conteudo"
                             Text="{Binding Texto, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="#111827" FontSize="14"/>
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tipo}" Value="Usuario">
                    <Setter TargetName="Balao" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Balao" Property="Background" Value="#4F46E5"/>
                    <Setter TargetName="Balao" Property="BorderThickness" Value="0"/>
                    <Setter TargetName="Conteudo" Property="Foreground" Value="White"/>
                    <Setter TargetName="Autor" Property="Foreground" Value="#C7D2FE"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Tipo}" Value="Ferramenta">
                    <Setter TargetName="Balao" Property="HorizontalAlignment" Value="Center"/>
                    <Setter TargetName="Balao" Property="Background" Value="#FEF3C7"/>
                    <Setter TargetName="Balao" Property="BorderBrush" Value="#FCD34D"/>
                    <Setter TargetName="Balao" Property="Padding" Value="12,6"/>
                    <Setter TargetName="Autor" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Conteudo" Property="FontSize" Value="12.5"/>
                    <Setter TargetName="Conteudo" Property="Foreground" Value="#92400E"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Tipo}" Value="Erro">
                    <Setter TargetName="Balao" Property="Background" Value="#FEE2E2"/>
                    <Setter TargetName="Balao" Property="BorderBrush" Value="#FCA5A5"/>
                    <Setter TargetName="Conteudo" Property="Foreground" Value="#991B1B"/>
                </DataTrigger>

                <!-- Enquanto a IA não mandou o primeiro pedaço do texto, mostra "pensando..." -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tipo}" Value="Assistente"/>
                        <Condition Binding="{Binding Texto}" Value=""/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Pensando" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Conteudo" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== BARRA LATERAL ===================== -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,20,20,16">

                <!-- Barra de status (fica no rodapé) -->
                <Border DockPanel.Dock="Bottom" Background="#F9FAFB" CornerRadius="8" Padding="10,8" Margin="0,12,0,0">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource CorTextoSuave}"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Assistente IA" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="WPF · .NET 10 · Microsoft.Extensions.AI" FontSize="12"
                                   Foreground="{StaticResource CorTextoSuave}" Margin="0,2,0,0"/>

                        <TextBlock Text="PROVEDOR DE IA" Style="{StaticResource Rotulo}"/>
                        <ComboBox ItemsSource="{Binding Provedores}"
                                  SelectionChanged="Provedor_SelectionChanged"
                                  SelectedItem="{Binding ProvedorSelecionado}"
                                  DisplayMemberPath="Nome"
                                  IsEnabled="{Binding NaoOcupado}"
                                  Padding="8,6"/>
                        <TextBlock Text="{Binding ProvedorSelecionado.Descricao}" TextWrapping="Wrap"
                                   FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,6,0,0"/>

                        <!-- Chave de API: só aparece para provedores de nuvem -->
                        <StackPanel Visibility="{Binding ProvedorSelecionado.PrecisaDeChave, Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="CHAVE DE API" Style="{StaticResource Rotulo}"/>
                            <PasswordBox x:Name="CaixaChave" PasswordChanged="CaixaChave_PasswordChanged"
                                         IsEnabled="{Binding NaoOcupado}" Padding="6,5"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource CorTextoSuave}" Margin="0,6,0,0">
                                <Run Text="Como obter:" FontWeight="SemiBold"/>
                                <Run Text="{Binding ProvedorSelecionado.ComoObterChave, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource CorTextoSuave}" Margin="0,4,0,0"
                                       Text="A chave fica só na memória e não é salva. Se o campo ficar vazio, o app procura a variável de ambiente."/>
                        </StackPanel>

                        <TextBlock Text="MODELO" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding NaoOcupado}" Padding="6,5"/>

                        <CheckBox IsChecked="{Binding UsarFerramentas}" IsEnabled="{Binding NaoOcupado}" Margin="0,14,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="13"
                                       Text="Permitir que a IA use as ferramentas do app (function calling)"/>
                        </CheckBox>

                        <TextBlock Text="AÇÕES" Style="{StaticResource Rotulo}"/>
                        <Button Content="📄  Resumir arquivo .txt" Command="{Binding ResumirArquivoCommand}"
                                Style="{StaticResource BotaoSecundario}"/>
                        <Button Content="🗑  Limpar conversa" Command="{Binding LimparCommand}"
                                Style="{StaticResource BotaoSecundario}"/>

                        <TextBlock Text="ESTOQUE (DADOS DO APP)" Style="{StaticResource Rotulo}"/>
                        <TextBlock Text="A IA não conhece estes dados: ela só os acessa chamando as ferramentas."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Estoque}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Produto}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Nome}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="8,0,0,0">
                                            <Run Text="{Binding Quantidade, Mode=OneWay}"/><Run Text=" un."/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== ÁREA DO CHAT ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="RolagemChat"
                          VerticalScrollBarVisibility="Auto"
                          Padding="28,18"
                          ScrollChanged="RolagemChat_ScrollChanged"
                          PreviewMouseWheel="RolagemChat_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding Mensagens}" ItemTemplate="{StaticResource ModeloMensagem}"/>
            </ScrollViewer>

            <!-- Tela inicial (quando ainda não há mensagens) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480"
                        IsHitTestVisible="False"
                        Visibility="{Binding SemMensagens, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="💬" FontSize="44" HorizontalAlignment="Center"/>
                <TextBlock Text="Comece uma conversa" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,8,0,8" Foreground="#111827"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource CorTextoSuave}"
                           Text="Experimente: &quot;Que dia é hoje?&quot;, &quot;Quantos mouses temos no estoque?&quot; ou &quot;Qual o produto mais caro?&quot;. Você também pode clicar em Resumir arquivo .txt."/>
            </StackPanel>

            <!-- Caixa de entrada -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="10" BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB" Padding="10,6">
                        <TextBox x:Name="CaixaEntrada"
                                 Text="{Binding TextoEntrada, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" MinHeight="28" FontSize="14">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding EnviarCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Border>

                    <Button Grid.Column="1" Content="Enviar" Margin="10,0,0,0"
                            Command="{Binding EnviarCommand}" Style="{StaticResource BotaoBase}"/>

                    <Button Grid.Column="2" Content="■  Parar" Margin="8,0,0,0"
                            Command="{Binding CancelarCommand}" Style="{StaticResource BotaoPerigo}"
                            Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisibilidade}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
